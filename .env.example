PORT=3000
DATABASE_URL=postgres://chaos:chaos@localhost:5432/chaos_garden
# Shared secret other Chaos Garden services (the proxy) use to read garden config.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
INTERNAL_API_KEY=change-me

# Origins allowed to call this API from a browser (comma separated). Default: the dashboard dev server.
CORS_ORIGIN=http://localhost:3001
# The ingest service, which stores request logs and stats (reached with INTERNAL_API_KEY).
INGEST_URL=http://localhost:3200
# How many gardens one IP may create per window (default 10 per hour).
# GARDEN_CREATE_LIMIT=10
# GARDEN_CREATE_WINDOW_MS=3600000
# Set to true behind a reverse proxy/load balancer so client IPs are read from X-Forwarded-For.
# TRUST_PROXY=false
