PORT=3200
# This service owns its own database (not the control API's).
DATABASE_URL=postgres://chaos:chaos@localhost:5432/chaos_ingest
REDIS_URL=redis://localhost:6379
# Must match the control API's INTERNAL_API_KEY (it reads logs through this service).
INTERNAL_API_KEY=change-me
# Optional tuning (defaults shown)
# EVENT_STREAM=chaos:requests
# CONSUMER_GROUP=ingest
# CONSUMER_NAME=<hostname>-<pid>
# BATCH_SIZE=200
# BLOCK_MS=2000
# CLAIM_IDLE_MS=30000
# MAX_DELIVERIES=5
# LOG_RETENTION_DAYS=7
# STATS_RETENTION_DAYS=30
# Logs: "json" for one JSON object per line (for log tools); default is human-readable.
# LOG_FORMAT=json
# Require a bearer token on /metrics (otherwise open; keep it on an internal network).
# METRICS_TOKEN=
